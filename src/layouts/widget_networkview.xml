<?xml version="1.0" encoding="utf-8"?>
<merge
    android:orientation="horizontal"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/signal_bluetooth"
        android:visibility="gone"
        android:layout_width="34.0dp"
        android:layout_height="34.0dp"
        android:tint="?te_white"
        android:importantForAccessibility="no"
        android:layout_marginStart="3.0dp" />
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/signal_mobile"
        android:visibility="gone"
        android:layout_width="34.0dp"
        android:layout_height="34.0dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="3.0dp" />
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@id/signal_wifi"
        android:visibility="gone"
        android:layout_width="34.0dp"
        android:layout_height="34.0dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="3.0dp" />
    <com.lecoauto.widget.lview.FadingTextView
        android:textSize="20.0sp"
        android:textStyle="bold"
        android:textColor="?te_white"
        android:gravity="center_vertical"
        android:id="@id/network_type"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:singleLine="true"
        android:layout_marginStart="3.0dp" />
</merge>