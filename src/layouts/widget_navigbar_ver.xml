<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@id/navig_bar"
        android:layout_width="match_parent"
        android:layout_height="70.0dp"
        android:layout_margin="@dimen/card_spacing"
        android:layout_alignParentBottom="true"
        app:cardBackgroundColor="#00fefefe"
        app:cardCornerRadius="@dimen/card_radius"
        app:cardElevation="0.0dp">
        <com.lecoauto.widget.lview.BlurView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@id/bar_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </com.lecoauto.widget.lview.BlurView>
    </androidx.cardview.widget.CardView>
</RelativeLayout>