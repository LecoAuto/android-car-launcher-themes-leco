<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.lecoauto.widget.lview.BlurView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <com.lecoauto.widget.lview.music.MusicCover
        android:id="@id/music_image"
        android:background="?app_blur_card"
        android:layout_width="50.0dp"
        android:layout_height="match_parent"
        android:layout_marginTop="10.0dp"
        android:layout_marginBottom="35.0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginStart="10.0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cover_radius="10.0dp"
        app:cover_size_mode="height" />
    <com.lecoauto.widget.lview.FadingTextView
        android:textStyle="bold"
        android:textColor="?te_white"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@id/music_name"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:text="没有歌曲在播放"
        android:singleLine="true"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/music_singer"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/music_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@id/music_image"
        app:layout_constraintVertical_weight="0.8" />
    <com.lecoauto.widget.lview.FadingTextView
        android:textColor="?su_white"
        android:ellipsize="marquee"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@id/music_singer"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="5.0dp"
        android:maxHeight="35.0dp"
        android:minHeight="15.0dp"
        android:text="歌手"
        android:singleLine="true"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:autoSizeTextType="uniform"
        app:layout_constraintBottom_toTopOf="@id/music_last"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/music_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_name"
        app:layout_constraintVertical_weight="0.7" />
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/music_last"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginStart="10.0dp"
        app:corner_radius="10.0dp"
        app:layout_constraintBottom_toBottomOf="@id/music_image"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/music_image"
        app:layout_constraintRight_toLeftOf="@id/music_play"
        app:layout_constraintTop_toBottomOf="@id/music_singer"
        app:layout_constraintVertical_weight="1.2"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:id="@id/icon_last"
            android:layout_width="17.0dp"
            android:layout_height="17.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:id="@id/music_play"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginStart="10.0dp"
        app:corner_radius="10.0dp"
        app:layout_constraintBottom_toBottomOf="@id/music_image"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/music_last"
        app:layout_constraintRight_toRightOf="@id/music_next"
        app:layout_constraintTop_toBottomOf="@id/music_singer"
        app:layout_constraintVertical_weight="1.0"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/icon_play"
            android:layout_width="17.0dp"
            android:layout_height="17.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:id="@id/music_next"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:corner_radius="10.0dp"
        app:layout_constraintBottom_toBottomOf="@id/music_image"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@id/music_play"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_singer"
        app:layout_constraintVertical_weight="1.0"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:id="@id/icon_next"
            android:layout_width="wrap_content"
            android:layout_height="17.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <ProgressBar
        android:id="@id/music_prog"
        android:background="?su_black"
        android:layout_width="match_parent"
        android:layout_height="5.0dp"
        android:layout_marginTop="10.0dp"
        android:layout_marginBottom="10.0dp"
        android:max="100"
        android:progress="0"
        android:layout_centerInParent="true"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_image"
        style="?android:progressBarStyleHorizontal" />
</androidx.constraintlayout.widget.ConstraintLayout>