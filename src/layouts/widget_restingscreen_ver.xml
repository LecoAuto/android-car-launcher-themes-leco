<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@id/card_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="360.0dp"
        android:layout_height="360.0dp"
        android:layout_marginTop="50.0dp"
        android:layout_centerInParent="true"
        android:layout_centerVertical="true"
        app:cardBackgroundColor="#00fefefe"
        app:cardCornerRadius="50.0dp"
        app:cardElevation="0.0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.lecoauto.widget.lview.music.MusicCover
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
        <com.lecoauto.widget.lview.ClockView
            android:background="#99000000"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:circle_color="#00fefefe"
            app:hour_color="#fffefefe"
            app:minute_color="#fffefefe"
            app:minute_mark_color="#70fefefe"
            app:quarter_mark_color="#70fefefe"
            app:second_color="#f44336" />
        <com.lecoauto.widget.lview.music.MusicName
            android:textSize="23.0sp"
            android:textColor="#fffefefe"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="30.0dp"
            android:layout_marginTop="60.0dp"
            android:singleLine="true" />
        <com.lecoauto.widget.lview.music.MusicSinger
            android:textSize="23.0sp"
            android:textColor="#fffefefe"
            android:ellipsize="marquee"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="30.0dp"
            android:layout_marginTop="100.0dp"
            android:singleLine="true" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="60.0dp"
            android:layout_marginBottom="35.0dp"
            android:layout_marginStart="10.0dp"
            android:layout_marginEnd="10.0dp">
            <com.lecoauto.widget.lview.EventView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="60.0dp"
                android:layout_height="60.0dp"
                android:layout_weight="1.0"
                app:background_normal="#10fefefe"
                app:corner_radius="30.0dp"
                app:ripple="true"
                app:ripple_color="@color/app_ripple"
                app:event_mode="music_last">
                <com.lecoauto.widget.lview.LImageView
                    android:layout_gravity="center"
                    android:layout_width="30.0dp"
                    android:layout_height="30.0dp"
                    android:src="@drawable/music_last"
                    android:scaleType="fitXY"
                    android:tint="#fffefefe" />
            </com.lecoauto.widget.lview.EventView>
            <com.lecoauto.widget.lview.EventView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="60.0dp"
                android:layout_height="60.0dp"
                android:layout_weight="1.0"
                android:layout_marginStart="10.0dp"
                android:layout_marginEnd="10.0dp"
                app:background_normal="#10fefefe"
                app:corner_radius="30.0dp"
                app:ripple="true"
                app:ripple_color="@color/app_ripple"
                app:event_mode="music_play">
                <com.lecoauto.widget.lview.LImageView
                    android:layout_gravity="center"
                    android:id="@id/leco_music_icon"
                    android:layout_width="30.0dp"
                    android:layout_height="30.0dp"
                    android:src="@drawable/music_play"
                    android:scaleType="fitXY"
                    android:tint="#fffefefe" />
            </com.lecoauto.widget.lview.EventView>
            <com.lecoauto.widget.lview.EventView
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="60.0dp"
                android:layout_height="60.0dp"
                android:layout_weight="1.0"
                app:background_normal="#10fefefe"
                app:corner_radius="30.0dp"
                app:ripple="true"
                app:ripple_color="@color/app_ripple"
                app:event_mode="music_next">
                <com.lecoauto.widget.lview.LImageView
                    android:layout_gravity="center"
                    android:layout_width="30.0dp"
                    android:layout_height="30.0dp"
                    android:src="@drawable/music_next"
                    android:scaleType="fitXY"
                    android:tint="#fffefefe" />
            </com.lecoauto.widget.lview.EventView>
        </LinearLayout>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:layout_width="8.0dp"
            android:layout_height="8.0dp"
            app:cardBackgroundColor="#f44336"
            app:cardCornerRadius="4.0dp" />
    </androidx.cardview.widget.CardView>
    <com.lecoauto.widget.lview.TimeView
        android:textSize="40.0sp"
        android:textStyle="bold"
        android:textColor="#fffefefe"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@id/time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15.0dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_view"
        app:time_format="@string/time_format_time" />
    <com.lecoauto.widget.lview.TimeView
        android:textSize="26.0sp"
        android:textColor="#70fefefe"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dp"
        android:singleLine="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/time"
        app:time_format="@string/time_format_month_day_with_weekday" />
    <com.lecoauto.widget.view.LrcView
        android:textStyle="bold"
        android:id="@id/lrc_view"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginTop="25.0dp"
        android:layout_marginBottom="15.0dp"
        android:fontFamily="serif"
        android:layout_marginStart="15.0dp"
        android:layout_marginEnd="15.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/date"
        app:lrcAnimationDuration="888"
        app:lrcCurrentTextColor="#fffefefe"
        app:lrcDividerHeight="15.0dp"
        app:lrcNormalTextColor="#70fefefe"
        app:lrcNormalTextSize="25.0sp"
        app:lrcPadding="20.0dp"
        app:lrcTextGravity="center"
        app:lrcTextSize="35.0sp"
        app:shieldLongClick="true" />
</androidx.constraintlayout.widget.ConstraintLayout>