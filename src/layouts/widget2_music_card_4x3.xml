<?xml version="1.0" encoding="utf-8"?>
<com.ruffian.library.widget.RConstraintLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:ripple="true"
    app:ripple_color="@color/app_ripple"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.lecoauto.widget.lview.music.MusicCover
        android:id="@id/music_image"
        android:background="?app_blur_card"
        android:layout_width="90.0dp"
        android:layout_height="90.0dp"
        android:layout_marginTop="10.0dp"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:layout_marginStart="10.0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cover_radius="@dimen/card_radius"
        app:cover_size_mode="height" />
    <LinearLayout
        android:id="@id/music_name_layout"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:layout_constraintBottom_toTopOf="@id/music_singer_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/music_image"
        app:layout_constraintTop_toTopOf="@id/music_image"
        app:layout_constraintVertical_weight="1.0">
        <com.lecoauto.widget.lview.FadingTextView
            android:textColor="?te_white"
            android:ellipsize="marquee"
            android:id="@id/music_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:singleLine="true"
            app:autoSizeMaxTextSize="20.0sp"
            app:autoSizeMinTextSize="12.0sp"
            app:autoSizeStepGranularity="1.0sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
    <LinearLayout
        android:id="@id/music_singer_layout"
        android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:layout_constraintBottom_toBottomOf="@id/music_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/music_image"
        app:layout_constraintTop_toBottomOf="@id/music_name_layout"
        app:layout_constraintVertical_weight="0.8">
        <com.lecoauto.widget.lview.FadingTextView
            android:textColor="?su_white"
            android:ellipsize="marquee"
            android:id="@id/music_singer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxHeight="35.0dp"
            android:minHeight="15.0dp"
            android:singleLine="true"
            app:autoSizeMaxTextSize="17.0sp"
            app:autoSizeMinTextSize="12.0sp"
            app:autoSizeStepGranularity="1.0sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>
    <com.lecoauto.widget.view.LrcView
        android:textStyle="bold"
        android:id="@id/lrc_view"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginBottom="5.0dp"
        android:fontFamily="serif"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:layout_constraintBottom_toBottomOf="@id/music_previous"
        app:layout_constraintTop_toBottomOf="@id/music_image"
        app:lrcAnimationDuration="888"
        app:lrcCurrentTextColor="?te_white"
        app:lrcDividerHeight="15.0dp"
        app:lrcNormalTextColor="?su_white"
        app:lrcNormalTextSize="17.0sp"
        app:lrcPadding="10.0dp"
        app:lrcTextGravity="center"
        app:lrcTextSize="20.0sp"
        app:shieldLongClick="true" />
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@id/music_previous"
        android:layout_width="0.0dp"
        android:layout_height="40.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginBottom="5.0dp"
        android:layout_marginStart="10.0dp"
        app:background_normal="?app_blur_wind"
        app:corner_radius="10.0dp"
        app:layout_constraintEnd_toStartOf="@id/music_play"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lrc_view"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:id="@id/icon_previous"
            android:layout_width="20.0dp"
            android:layout_height="20.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:id="@id/music_play"
        android:layout_width="0.0dp"
        android:layout_height="40.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginBottom="5.0dp"
        android:layout_marginStart="10.0dp"
        app:background_normal="?app_blur_wind"
        app:corner_radius="10.0dp"
        app:layout_constraintEnd_toStartOf="@id/music_next"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/music_previous"
        app:layout_constraintTop_toBottomOf="@id/lrc_view"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:layout_gravity="center"
            android:id="@id/icon_play"
            android:layout_width="20.0dp"
            android:layout_height="20.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center"
        android:id="@id/music_next"
        android:layout_width="0.0dp"
        android:layout_height="40.0dp"
        android:layout_marginTop="5.0dp"
        android:layout_marginBottom="5.0dp"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:background_normal="?app_blur_wind"
        app:corner_radius="10.0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/music_play"
        app:layout_constraintTop_toBottomOf="@id/lrc_view"
        app:ripple="true"
        app:ripple_color="@color/app_ripple">
        <ImageView
            android:id="@id/icon_next"
            android:layout_width="20.0dp"
            android:layout_height="20.0dp"
            android:tint="?te_white"
            android:importantForAccessibility="no" />
    </com.ruffian.library.widget.RLinearLayout>
    <ProgressBar
        android:id="@id/music_prog"
        android:background="?su_black"
        android:layout_width="match_parent"
        android:layout_height="5.0dp"
        android:layout_marginTop="10.0dp"
        android:layout_marginBottom="10.0dp"
        android:max="100"
        android:progress="0"
        android:layout_marginStart="10.0dp"
        android:layout_marginEnd="10.0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/music_play"
        style="?android:progressBarStyleHorizontal" />
</com.ruffian.library.widget.RConstraintLayout>