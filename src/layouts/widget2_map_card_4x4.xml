<?xml version="1.0" encoding="utf-8"?>
<com.ruffian.library.widget.RLinearLayout
    android:gravity="center_vertical"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    app:ripple="true"
    app:ripple_color="@color/app_ripple"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="20.0dp"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0">
        <com.lecoauto.widget.lview.TimeView
            android:textSize="40.0sp"
            android:textStyle="bold"
            android:textColor="?te_white"
            android:gravity="center_horizontal"
            android:paddingBottom="10.0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="10.0dp"
            android:letterSpacing="0.2" />
        <com.lecoauto.widget.lview.TimeView
            android:textSize="25.0sp"
            android:textStyle="bold"
            android:textColor="?te_white"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="10.0dp"
            android:letterSpacing="0.2"
            app:time_format="@string/time_format_month_day_with_weekday" />
    </LinearLayout>
    <com.lecoauto.widget2.view.SpeedView
        android:textSize="45.0sp"
        android:textStyle="bold"
        android:textColor="?te_white"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_width="100.0dp"
        android:layout_height="100.0dp" />
    <com.ruffian.library.widget.RLinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="0.0dp"
        android:layout_weight="1.0">
        <com.ruffian.library.widget.RLinearLayout
            android:orientation="vertical"
            android:id="@id/amap"
            android:padding="10.0dp"
            android:layout_width="0.0dp"
            android:layout_height="100.0dp"
            android:layout_weight="1.0"
            app:corner_radius="15.0dp"
            app:ripple="true"
            app:ripple_color="@color/app_ripple">
            <ImageView
                android:id="@id/amap_icon"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_weight="5.0"
                android:importantForAccessibility="no" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="?te_white"
                android:gravity="center"
                android:id="@id/amap_text"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_marginTop="7.0dp"
                android:text="@string/map_card_navig"
                android:layout_weight="3.0" />
        </com.ruffian.library.widget.RLinearLayout>
        <com.ruffian.library.widget.RLinearLayout
            android:orientation="vertical"
            android:id="@id/work"
            android:padding="10.0dp"
            android:layout_width="0.0dp"
            android:layout_height="100.0dp"
            android:layout_weight="1.0"
            app:corner_radius="15.0dp"
            app:ripple="true"
            app:ripple_color="@color/app_ripple">
            <ImageView
                android:id="@id/work_icon"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_weight="5.0"
                android:importantForAccessibility="no" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="?te_white"
                android:gravity="center"
                android:id="@id/work_text"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_marginTop="7.0dp"
                android:text="@string/map_card_work"
                android:layout_weight="3.0" />
        </com.ruffian.library.widget.RLinearLayout>
        <com.ruffian.library.widget.RLinearLayout
            android:orientation="vertical"
            android:id="@id/home"
            android:padding="10.0dp"
            android:layout_width="0.0dp"
            android:layout_height="100.0dp"
            android:layout_weight="1.0"
            app:corner_radius="15.0dp"
            app:ripple="true"
            app:ripple_color="@color/app_ripple">
            <ImageView
                android:id="@id/home_icon"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_weight="5.0"
                android:importantForAccessibility="no" />
            <TextView
                android:textSize="14.0sp"
                android:textColor="?te_white"
                android:gravity="center"
                android:id="@id/home_text"
                android:layout_width="match_parent"
                android:layout_height="0.0dp"
                android:layout_marginTop="7.0dp"
                android:text="@string/map_card_home"
                android:layout_weight="3.0" />
        </com.ruffian.library.widget.RLinearLayout>
    </com.ruffian.library.widget.RLinearLayout>
</com.ruffian.library.widget.RLinearLayout>